# ==============================================================================
# STAFFSYNC ENVIRONMENT CONFIGURATION (VERCEL & PRODUCTION)
# ==============================================================================

# Supabase Production PostgreSQL Database (Required for persistent multi-browser data)
# Obtain these from your Supabase Project Settings -> API:
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-public-key"

# Optional Serverless Service Role (for elevated backend health checks / migrations)
SUPABASE_SERVICE_ROLE_KEY=""

# GEMINI_API_KEY: Required for Gemini AI API calls (if enabled)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
